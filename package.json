{
  "name": "local-ai-browser",
  "version": "1.0.0",
  "description": "本地AI智能浏览器 - 基于Chromium的本地化AI增强浏览器",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "npm run build && tsc -p tsconfig.electron.json && electron .",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "npm run build && tsc -p tsconfig.electron.json && electron-builder --win --dir"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "pinia": "^3.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue": "^3.4.21"
  },
  "build": {
    "appId": "com.localai.browser",
    "productName": "LocalAIBrowser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "portable": {
      "artifactName": "LocalAIBrowser-${version}-portable.exe"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "author": "LocalAIBrowser"
}